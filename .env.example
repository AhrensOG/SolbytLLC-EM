# PostgreSQL connection string (Sequelize)
# Local dev example (adjust to your setup):
DATABASE_URL=postgresql://postgres:password@localhost:5432/sexpense

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string

# Optional: Auth.js trust host (needed when deploying behind a proxy/domain)
AUTH_TRUST_HOST=true

# Google OAuth (create credentials in Google Cloud Console:
# "API y servicios" > "Credenciales" > "Crear credenciales" > "ID de cliente OAuth")
# Redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#              https://TU-DOMINIO/api/auth/callback/google (production)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GoCardless Bank Account Data (open banking, read-only).
# Crea una cuenta gratuita en https://gocardless.com/bank-account-data/
# y genera tus credenciales en el portal (sección "User secrets").
# Callback: la app usa /bank/callback automáticamente (sin configurar nada en GoCardless).
GC_SECRET_ID=your-gocardless-secret-id
GC_SECRET_KEY=your-gocardless-secret-key
