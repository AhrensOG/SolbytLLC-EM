# PostgreSQL connection string (Sequelize)
# Local dev example (adjust to your setup):
DATABASE_URL=postgresql://postgres:password@localhost:5432/sexpense

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string

# Optional: Auth.js trust host (needed when deploying behind a proxy/domain)
AUTH_TRUST_HOST=true

# Google OAuth (create credentials in Google Cloud Console:
# "API y servicios" > "Credenciales" > "Crear credenciales" > "ID de cliente OAuth")
# Redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#              https://TU-DOMINIO/api/auth/callback/google (production)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Enable Banking (open banking AIS, read-only) — https://enablebanking.com
# Crea una aplicación "Production" en el Control Panel y activala
# "Activate by linking accounts". El App ID es el UUID de la aplicación.
EB_APP_ID=your-enablebanking-app-id

# Clave privada RSA de la aplicación (PEM). O usa EB_PRIVATE_KEY_B64 con
# el contenido en base64 de una sola línea (base64 -w0 <app-id>.pem).
EB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY----- ... -----END RSA PRIVATE KEY-----"
